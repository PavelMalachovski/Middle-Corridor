# Telegram
BOT_TOKEN=
CHANNEL_ID=            # id публичного канала (напр. -100...) или @username
ADMIN_USER_IDS=        # tg user id админов через запятую

# Database
DATABASE_URL=postgresql+asyncpg://mc:mc@localhost:5433/mc_status

# AIS
AISSTREAM_API_KEY=
VESSELAPI_API_KEY=
VESSELAPI_WEBHOOK_SECRET=   # пусто = вебхук /webhooks/vesselapi выключен
# bbox "lat_min,lon_min,lat_max,lon_max"
AIS_BBOX_CASPIAN=36.5,47.0,47.0,54.5
AIS_BBOX_BLACK_SEA=41.0,40.5,43.5,42.5
AIS_MIN_SAVE_INTERVAL_MINUTES=5

# Weather thresholds (m/s) — стартовые значения, требуют калибровки на реальных данных
WEATHER_WATCH_WIND=10
WEATHER_WARNING_WIND=13.8
WEATHER_WARNING_GUST=15
WEATHER_CRITICAL_WIND=17
WEATHER_CRITICAL_GUST=21

# Behaviour
AUTO_PUBLISH_REPORTS=false
SCHEDULER_ENABLED=false   # false: погода/новости по командам /poll_weather /poll_news; true: автопилот
# RSS/Atom-ленты через запятую (WordPress-сайты обычно отдают /feed/)
NEWS_SOURCES=https://astanatimes.com/feed/,https://timesca.com/feed/,https://www.newsilkroaddiscovery.com/feed/
WEATHER_POLL_MINUTES=45
NEWS_POLL_MINUTES=60
NEWS_MAX_PER_RUN=3     # не больше N постов в канал за прогон
NEWS_MAX_AGE_DAYS=7    # старше — сохраняем в архив без публикации

# Runtime
LOG_LEVEL=INFO
ENV=production
PORT=8000
